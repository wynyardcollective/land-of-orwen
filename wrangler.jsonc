{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rough",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "rough"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rough-players",
      // Replace with the UUID from `wrangler d1 create rough-players` before remote deploy
      // (or run `npm run deploy:prod` which creates it and patches this file)
      "database_id": "46c5328a-87fe-4dab-9e7b-d66ea7dfd131",
      "migrations_dir": "migrations"
    }
  ],
  // Custom domains — zone rough.co.nz must live on the same Cloudflare account
  "routes": [
    { "pattern": "rough.co.nz", "custom_domain": true },
    { "pattern": "www.rough.co.nz", "custom_domain": true }
  ]
}
