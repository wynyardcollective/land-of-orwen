{
  "name": "rough",
  "version": "0.1.0",
  "private": true,
  "description": "rough — browser idle RPG (rough.co.nz)",
  "repository": {
    "type": "git",
    "url": "https://github.com/wynyardcollective/rough.git"
  },
  "scripts": {
    "dev": "next dev --port 43127",
    "build": "next build",
    "start": "next start --port 43127",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:prod": "bash scripts/cf-deploy.sh",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply rough-players --local",
    "db:migrate:remote": "wrangler d1 migrations apply rough-players --remote",
    "icons:generate": "node scripts/generate-app-icons.mjs && node scripts/generate-android-mipmaps.mjs",
    "mobile:install": "cd mobile && npm install",
    "mobile:sync": "cd mobile && npm install && npx cap sync android",
    "mobile:open": "cd mobile && npx cap open android"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "nanoid": "^6.0.1",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "playwright": "^1.49.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.125.0"
  }
}
